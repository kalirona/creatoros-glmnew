DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── Clerk Authentication (Phase B — foundation, not yet enforcing auth) ────
# Get these from your Clerk dashboard: https://dashboard.clerk.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY — safe for browser (public)
# CLERK_SECRET_KEY — server-only (NEVER expose to browser, NEVER commit real value)
#
# Leave empty to keep the existing demo authentication (getDemoUser) working.
# Populate with real Clerk keys to enable Clerk sign-in/sign-up pages.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk redirect URLs (optional — defaults to /sign-in and /sign-up)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
