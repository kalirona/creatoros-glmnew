DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── n8n Integration (Phase 1 — foundation, not yet routing AI through n8n) ──
# All vars below are optional in Phase 1. If unset, n8n integration is disabled
# and the existing AI engine continues to work unchanged.
#
# N8N_BASE_URL       — Your self-hosted n8n URL (no trailing slash)
# N8N_API_KEY        — API key for authenticating to n8n webhooks (sent as X-N8N-API-Key header)
# N8N_WEBHOOK_SECRET — Shared secret for HMAC-SHA256 request signing (n8n verifies X-CreatorOS-Signature)
# N8N_TIMEOUT_MS     — Request timeout in milliseconds (default: 30000)
# N8N_AI_ENABLED     — Master switch: 'true' or '1' to enable, anything else = disabled

N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_MS=30000
N8N_AI_ENABLED=false
