// CreatorOS — Multi-tenant creator platform schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  avatarUrl     String?
  bio           String?
  role          String   @default("OWNER") // global account role
  credits       Int      @default(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   WorkspaceMember[]
  posts         CommunityPost[]
  comments      CommunityComment[]
  events        CommunityEvent[]
  rsvps         EventRSVP[]
  enrollments   Enrollment[]
  orders        Order[]
  aiConversations AiConversation[]
  creditTxns    CreditTransaction[]
  aiGenerations AiGeneration[]
}

model Workspace {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logoUrl       String?
  plan          String   @default("PRO") // FREE | PRO | SCALE | ENTERPRISE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       WorkspaceMember[]
  courses       Course[]
  products      Product[]
  posts         CommunityPost[]
  customers     Customer[]
  emailCampaigns EmailCampaign[]
  affiliates    Affiliate[]
  pages         WebPage[]
  memberships   MembershipPlan[]
  communitySpaces CommunitySpace[]
  communityEvents CommunityEvent[]
  invitations   Invitation[]
}

model WorkspaceMember {
  id              String   @id @default(cuid())
  userId          String
  workspaceId     String
  role            String   @default("MEMBER") // OWNER|ADMIN|MANAGER|INSTRUCTOR|MODERATOR|MEMBER|STUDENT|AFFILIATE|GUEST
  memberStatus    String   @default("ACTIVE") // ACTIVE|SUSPENDED|BANNED|MUTED
  mutedUntil      DateTime?
  suspendedUntil  DateTime?
  bannedUntil     DateTime?
  banReason       String?
  lastSeenAt      DateTime @default(now())
  joinedAt        DateTime @default(now())
  postsCount      Int      @default(0)
  commentsCount   Int      @default(0)
  likesReceived   Int      @default(0)
  badges          String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, memberStatus])
}

model Course {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String
  description  String
  thumbnailUrl String?
  category     String   @default("Marketing")
  price        Float    @default(0)
  level        String   @default("BEGINNER") // BEGINNER|INTERMEDIATE|ADVANCED
  status       String   @default("PUBLISHED") // DRAFT|PUBLISHED|ARCHIVED
  rating       Float    @default(0)
  studentsCount Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sections     Section[]
  enrollments  Enrollment[]
}

model Section {
  id          String   @id @default(cuid())
  courseId     String
  title       String
  position    Int      @default(0)
  lessons     Lesson[]

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Lesson {
  id          String   @id @default(cuid())
  sectionId   String
  title       String
  content     String
  type        String   @default("VIDEO") // VIDEO|TEXT|PDF|AUDIO|QUIZ
  duration    Int      @default(0) // minutes
  position    Int      @default(0)
  isPreview   Boolean  @default(false)

  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  progress    Float    @default(0)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Product {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  description  String
  coverUrl     String?
  type         String   @default("DIGITAL") // DIGITAL|BUNDLE|MEMBERSHIP|COURSE
  price        Float
  compareAt    Float?
  fileUrl      String?
  salesCount   Int      @default(0)
  rating       Float    @default(0)
  status       String   @default("ACTIVE") // ACTIVE|DRAFT|ARCHIVED
  createdAt    DateTime @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders       Order[]
}

model Order {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String
  productId    String?
  amount       Float
  currency     String   @default("USD")
  status       String   @default("COMPLETED") // PENDING|COMPLETED|REFUNDED|FAILED
  customerEmail String
  customerName String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model CommunityPost {
  id           String   @id @default(cuid())
  workspaceId  String
  spaceId      String?
  userId       String
  category     String   @default("General")
  postType     String   @default("POST") // POST|ANNOUNCEMENT|QUESTION|POLL|MEDIA
  title        String
  content      String
  likesCount   Int      @default(0)
  commentsCount Int     @default(0)
  isPinned     Boolean  @default(false)
  isLocked     Boolean  @default(false)
  isArchived   Boolean  @default(false)
  isEdited     Boolean  @default(false)
  editCount    Int      @default(0)
  hashtags     String   @default("[]")
  mentions     String   @default("[]")
  pollOptions  String   @default("[]")
  attachments  String   @default("[]")
  reactions    String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  space        CommunitySpace? @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  comments     CommunityComment[]
  history      PostHistory[]

  @@index([workspaceId, createdAt])
  @@index([spaceId, createdAt])
}

model PostHistory {
  id           String   @id @default(cuid())
  postId       String
  editedBy     String
  title        String
  content      String
  version      Int
  createdAt    DateTime @default(now())

  post         CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId])
}

model CommunityComment {
  id          String   @id @default(cuid())
  postId      String
  parentId    String?
  userId      String
  content     String
  likesCount  Int      @default(0)
  isEdited    Boolean  @default(false)
  mentions    String   @default("[]")
  attachments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent      CommunityComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     CommunityComment[] @relation("CommentReplies")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([parentId])
}

model CommunitySpace {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  slug         String
  description  String   @default("")
  icon         String   @default("Hash")
  color        String   @default("emerald")
  visibility   String   @default("PUBLIC") // PUBLIC|PRIVATE|HIDDEN|WORKSPACE_ONLY
  memberCount  Int      @default(0)
  postCount    Int      @default(0)
  status       String   @default("ACTIVE") // ACTIVE|ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts        CommunityPost[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model CommunityEvent {
  id           String   @id @default(cuid())
  workspaceId  String
  spaceId      String?
  userId       String
  title        String
  description  String   @default("")
  type         String   @default("ONLINE") // ONLINE|OFFLINE|ZOOM|MEET|TEAMS
  location     String?
  meetingUrl   String?
  startTime    DateTime
  endTime      DateTime?
  bannerUrl    String?
  maxAttendees Int?
  status       String   @default("SCHEDULED") // SCHEDULED|LIVE|COMPLETED|CANCELLED
  createdAt    DateTime @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvps        EventRSVP[]

  @@index([workspaceId, startTime])
}

model EventRSVP {
  id           String   @id @default(cuid())
  eventId      String
  userId       String
  status       String   @default("GOING") // GOING|MAYBE|NOT_GOING
  createdAt    DateTime @default(now())

  event        CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Invitation {
  id            String    @id @default(cuid())
  workspaceId   String
  invitedBy     String
  email         String?
  username      String?
  token         String    @unique
  role          String    @default("MEMBER")
  status        String    @default("PENDING") // PENDING|ACCEPTED|EXPIRED|REVOKED
  message       String    @default("")
  expiresAt     DateTime
  acceptedAt    DateTime?
  acceptedByUserId String?
  revokedAt     DateTime?
  revokedBy     String?
  createdAt     DateTime  @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email])
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String
  type         String   // POST|COMMENT|REPLY|MENTION|INVITATION|EVENT_REMINDER|RSVP_UPDATE|REACTION|BADGE|WARNING|SYSTEM
  title        String
  body         String   @default("")
  link         String   @default("")
  actorId      String?
  entityId     String?
  entityType   String?
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, read])
  @@index([workspaceId, createdAt])
}

model ModerationReport {
  id           String   @id @default(cuid())
  workspaceId  String
  reporterId   String
  targetType   String   // POST|COMMENT|USER|EVENT
  targetId     String
  reason       String   // SPAM|HARASSMENT|HATE_SPEECH|VIOLENCE|NSFW|OTHER
  description  String   @default("")
  status       String   @default("PENDING") // PENDING|REVIEWING|RESOLVED|DISMISSED
  resolvedBy   String?
  resolution   String?
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  @@index([workspaceId, status])
  @@index([targetType, targetId])
}

model BannedKeyword {
  id           String   @id @default(cuid())
  workspaceId  String
  keyword      String
  action       String   @default("BLOCK") // BLOCK|REVIEW|REPLACE
  replacement  String?
  severity     String   @default("MEDIUM")
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([workspaceId])
}

model AuditLog {
  id           String   @id @default(cuid())
  workspaceId  String
  actorId      String
  actorRole    String?
  action       String
  targetType   String?
  targetId     String?
  metadata     String   @default("{}")
  ip           String?
  createdAt    DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorId])
}

model MemberWarning {
  id           String   @id @default(cuid())
  memberId     String
  workspaceId  String
  issuedBy     String
  reason       String
  severity     String   @default("WARNING")
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([workspaceId])
}

model Customer {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  email        String
  tags         String   @default("")
  ltv          Float    @default(0)
  ordersCount  Int      @default(0)
  status       String   @default("ACTIVE") // ACTIVE|CHURNED|LEAD
  createdAt    DateTime @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model EmailCampaign {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  subject      String
  previewText  String    @default("")
  body         String    @default("")
  type         String    @default("BROADCAST") // BROADCAST|AUTOMATION|SEQUENCE
  status       String    @default("DRAFT") // DRAFT|SCHEDULED|SENT
  audience     String    @default("ALL") // ALL|STUDENTS|CUSTOMERS|MEMBERS
  recipients   Int       @default(0)
  openRate     Float     @default(0)
  clickRate    Float     @default(0)
  sentAt       DateTime?
  scheduledAt  DateTime?
  createdBy     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model Affiliate {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  email        String
  code         String   @unique
  clicks       Int      @default(0)
  conversions  Int      @default(0)
  earnings     Float    @default(0)
  commissionRate Float  @default(0.3)
  status       String   @default("ACTIVE")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WebPage {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String
  slug         String
  type         String   @default("LANDING") // LANDING|SALES|HOME|ABOUT|CONTACT|BLOG|PRICING
  status       String   @default("PUBLISHED")
  visits       Int      @default(0)
  createdAt    DateTime @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model MembershipPlan {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  price        Float
  interval     String   @default("MONTHLY") // MONTHLY|YEARLY|LIFETIME
  members      Int      @default(0)
  status       String   @default("ACTIVE")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AiConversation {
  id           String   @id @default(cuid())
  userId       String
  tool         String   @default("CHAT") // CHAT|COURSE|LESSON|EMAIL|SALES|BLOG|SOCIAL|SCRIPT
  title        String
  messages     String   @default("[]") // JSON array
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  amount       Int      // negative = spent, positive = purchased
  reason       String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===== AI Platform (database-driven, admin-managed) =====

model AiProvider {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  apiKey      String   @default("")
  baseUrl     String   @default("")
  isActive    Boolean  @default(true)
  priority    Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  models      AiModel[]
}

model AiModel {
  id           String   @id @default(cuid())
  providerId   String
  name         String   // internal id
  displayName  String
  contextWindow Int     @default(128000)
  isDefault    Boolean  @default(false)
  costMultiplier Float  @default(1.0)
  isActive     Boolean  @default(true)

  provider     AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model AiTool {
  id           String   @id @default(cuid())
  slug         String   @unique // COURSE_GENERATOR | EMAIL_WRITER | ...
  name         String
  description  String
  icon         String   @default("Sparkles")
  category     String   @default("Content") // Content | Courses | Marketing | Sales | Strategy
  systemPrompt String   @default("")
  userInputPrompt String @default("") // template injected with user input
  creditCost   Int      @default(5)
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(4000)
  outputType   String   @default("MARKDOWN") // MARKDOWN | COURSE | LESSON | EMAIL | SALES_PAGE | BLOG | SOCIAL | SCRIPT | PRODUCT | LANDING
  isVisible    Boolean  @default(true)
  isPro        Boolean  @default(false)
  outputSchema String   @default("") // JSON schema hint for structured outputs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  generations  AiGeneration[]
}

model AiGeneration {
  id           String   @id @default(cuid())
  userId       String
  toolId       String
  toolSlug     String
  title        String
  input        String   @default("") // user prompt
  output       String   @default("") // raw AI text
  structured   String   @default("{}") // JSON structured output (course obj, etc.)
  status       String   @default("COMPLETED") // PENDING | COMPLETED | FAILED
  creditsUsed  Int      @default(0)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool         AiTool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model AdminSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @default("")
  category    String   @default("general") // general | billing | ai | storage | email
  updatedAt   DateTime @updatedAt
}

// ===== Pages & Funnels system =====

model Page {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String
  slug         String
  type         String   @default("PAGE") // PAGE | LANDING | FUNNEL_STEP | BLOG | HOME | ABOUT | CONTACT | LEGAL | THANK_YOU
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | SCHEDULED
  category     String   @default("General") // for landing pages: Course | Membership | Product | Community | Agency | SaaS | LeadMagnet | Newsletter | Webinar | Coaching
  funnelId     String?
  seoTitle     String   @default("")
  seoDescription String @default("")
  ogImage      String   @default("")
  schema       String   @default("{}")
  visits       Int      @default(0)
  conversions  Int      @default(0)
  publishedAt  DateTime?
  scheduledAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sections     PageSection[]
  versions     PageVersion[]
  funnelSteps  FunnelStep[]
}

model PageSection {
  id          String   @id @default(cuid())
  pageId      String
  type        String   // HERO | FEATURES | BENEFITS | PRICING | TESTIMONIALS | FAQ | VIDEO | GALLERY | COUNTDOWN | CTA | NEWSLETTER | FOOTER | TEXT | HEADING
  content     String   @default("{}") // JSON content
  position    Int      @default(0)
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  version     Int
  sections    String   @default("[]") // JSON snapshot of sections
  note        String   @default("")
  createdAt   DateTime @default(now())

  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Funnel {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  description  String   @default("")
  type         String   @default("SALES") // SALES | LEAD | WEBINAR | LAUNCH
  status       String   @default("DRAFT") // DRAFT | LIVE | PAUSED
  visits       Int      @default(0)
  conversions  Int      @default(0)
  revenue      Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  steps        FunnelStep[]
}

model FunnelStep {
  id          String   @id @default(cuid())
  funnelId    String
  pageId      String?
  name        String
  type        String   // LANDING | CHECKOUT | UPSELL | DOWNSELL | THANK_YOU | EMAIL | COMMUNITY_INVITE | COURSE_ACCESS
  position    Int      @default(0)
  isRequired  Boolean  @default(true)

  funnel      Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  page        Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
}

model BlogPost {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String
  slug         String
  excerpt      String   @default("")
  content      String   @default("")
  coverUrl     String   @default("")
  category     String   @default("General")
  tags         String   @default("")
  author       String   @default("Alex Rivera")
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | SCHEDULED
  seoTitle     String   @default("")
  seoDescription String @default("")
  visits       Int      @default(0)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @default("")
  category    String   @default("brand") // brand | header | footer | analytics | seo | domains
  updatedAt   DateTime @updatedAt
}

