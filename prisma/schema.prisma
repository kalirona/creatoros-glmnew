// CreatorOS — Multi-tenant creator platform schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  avatarUrl     String?
  bio           String?
  role          String   @default("MEMBER") // Global account role: SUPER_ADMIN|MEMBER (workspace roles are on WorkspaceMember)
  credits       Int      @default(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   WorkspaceMember[]
  posts         CommunityPost[]
  comments      CommunityComment[]
  events        CommunityEvent[]
  rsvps         EventRSVP[]
  enrollments   Enrollment[]
  orders        Order[]
  aiConversations AiConversation[]
  creditTxns    CreditTransaction[]
  aiGenerations AiGeneration[]
}

model Workspace {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logoUrl       String?
  plan          String   @default("PRO") // FREE | PRO | SCALE | ENTERPRISE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       WorkspaceMember[]
  courses       Course[]
  products      Product[]
  posts         CommunityPost[]
  customers     Customer[]
  emailCampaigns EmailCampaign[]
  affiliates    Affiliate[]
  pages         WebPage[]
  memberships   MembershipPlan[]
  communitySpaces CommunitySpace[]
  communityEvents CommunityEvent[]
  invitations   Invitation[]
  // Back-relations for models that had workspaceId but no relation
  funnels       Funnel[]
  blogPosts     BlogPost[]
  orders        Order[]
  pageModels    Page[]
  enrollments   Enrollment[]
}

model WorkspaceMember {
  id              String   @id @default(cuid())
  userId          String
  workspaceId     String
  role            String   @default("MEMBER") // OWNER|ADMIN|MANAGER|INSTRUCTOR|MODERATOR|MEMBER|STUDENT|AFFILIATE|GUEST
  memberStatus    String   @default("ACTIVE") // ACTIVE|SUSPENDED|BANNED|MUTED
  mutedUntil      DateTime?
  suspendedUntil  DateTime?
  bannedUntil     DateTime?
  banReason       String?
  lastSeenAt      DateTime @default(now())
  joinedAt        DateTime @default(now())
  postsCount      Int      @default(0)
  commentsCount   Int      @default(0)
  likesReceived   Int      @default(0)
  badges          String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, memberStatus])
}

model Course {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String
  description  String
  thumbnailUrl String?
  category     String   @default("Marketing")
  price        Float    @default(0)
  level        String   @default("BEGINNER") // BEGINNER|INTERMEDIATE|ADVANCED
  status       String   @default("PUBLISHED") // DRAFT|PUBLISHED|ARCHIVED
  rating       Float    @default(0)
  studentsCount Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sections     Section[]
  enrollments  Enrollment[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model Section {
  id          String   @id @default(cuid())
  courseId     String
  title       String
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  lessons     Lesson[]

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, position])
}

model Lesson {
  id          String   @id @default(cuid())
  sectionId   String
  title       String
  content     String
  type        String   @default("VIDEO") // VIDEO|TEXT|PDF|AUDIO|QUIZ
  duration    Int      @default(0) // minutes
  position    Int      @default(0)
  isPreview   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  workspaceId String?
  progress    Float    @default(0)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([workspaceId])
}

model Product {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  description  String
  coverUrl     String?
  type         String   @default("DIGITAL") // DIGITAL|BUNDLE|MEMBERSHIP|COURSE
  price        Float
  compareAt    Float?
  fileUrl      String?
  salesCount   Int      @default(0)
  rating       Float    @default(0)
  status       String   @default("ACTIVE") // ACTIVE|DRAFT|ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model Order {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String
  productId    String?
  amount       Float
  currency     String   @default("USD")
  status       String   @default("COMPLETED") // PENDING|COMPLETED|REFUNDED|FAILED
  customerEmail String
  customerName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([userId])
  @@index([productId])
}

model CommunityPost {
  id           String   @id @default(cuid())
  workspaceId  String
  spaceId      String?
  userId       String
  category     String   @default("General")
  postType     String   @default("POST") // POST|ANNOUNCEMENT|QUESTION|POLL|MEDIA
  title        String
  content      String
  likesCount   Int      @default(0)
  commentsCount Int     @default(0)
  isPinned     Boolean  @default(false)
  isLocked     Boolean  @default(false)
  isArchived   Boolean  @default(false)
  isEdited     Boolean  @default(false)
  editCount    Int      @default(0)
  hashtags     String   @default("[]")
  mentions     String   @default("[]")
  pollOptions  String   @default("[]")
  attachments  String   @default("[]")
  reactions    String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  space        CommunitySpace? @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  comments     CommunityComment[]
  history      PostHistory[]

  @@index([workspaceId, createdAt])
  @@index([spaceId, createdAt])
}

model PostHistory {
  id           String   @id @default(cuid())
  postId       String
  editedBy     String
  title        String
  content      String
  version      Int
  createdAt    DateTime @default(now())

  post         CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId])
  @@unique([postId, version])
}

model CommunityComment {
  id          String   @id @default(cuid())
  postId      String
  parentId    String?
  userId      String
  content     String
  likesCount  Int      @default(0)
  isEdited    Boolean  @default(false)
  mentions    String   @default("[]")
  attachments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent      CommunityComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     CommunityComment[] @relation("CommentReplies")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([userId, createdAt])
}

model CommunitySpace {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  slug         String
  description  String   @default("")
  icon         String   @default("Hash")
  color        String   @default("emerald")
  visibility   String   @default("PUBLIC") // PUBLIC|PRIVATE|HIDDEN|WORKSPACE_ONLY
  memberCount  Int      @default(0)
  postCount    Int      @default(0)
  status       String   @default("ACTIVE") // ACTIVE|ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts        CommunityPost[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model CommunityEvent {
  id           String   @id @default(cuid())
  workspaceId  String
  spaceId      String?
  userId       String
  title        String
  description  String   @default("")
  type         String   @default("ONLINE") // ONLINE|OFFLINE|ZOOM|MEET|TEAMS
  location     String?
  meetingUrl   String?
  startTime    DateTime
  endTime      DateTime?
  bannerUrl    String?
  maxAttendees Int?
  status       String   @default("SCHEDULED") // SCHEDULED|LIVE|COMPLETED|CANCELLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvps        EventRSVP[]

  @@index([workspaceId, startTime])
  @@index([workspaceId, status])
  @@index([userId, startTime])
  @@index([spaceId, startTime])
}

model EventRSVP {
  id           String   @id @default(cuid())
  eventId      String
  userId       String
  status       String   @default("GOING") // GOING|MAYBE|NOT_GOING
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  event        CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model Invitation {
  id            String    @id @default(cuid())
  workspaceId   String
  invitedBy     String
  email         String?
  username      String?
  token         String    @unique
  role          String    @default("MEMBER")
  status        String    @default("PENDING") // PENDING|ACCEPTED|EXPIRED|REVOKED
  message       String    @default("")
  expiresAt     DateTime
  acceptedAt    DateTime?
  acceptedByUserId String?
  revokedAt     DateTime?
  revokedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email])
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String
  type         String   // POST|COMMENT|REPLY|MENTION|INVITATION|EVENT_REMINDER|RSVP_UPDATE|REACTION|BADGE|WARNING|SYSTEM
  title        String
  body         String   @default("")
  link         String   @default("")
  actorId      String?
  entityId     String?
  entityType   String?
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
}

model ModerationReport {
  id           String   @id @default(cuid())
  workspaceId  String
  reporterId   String
  targetType   String   // POST|COMMENT|USER|EVENT
  targetId     String
  reason       String   // SPAM|HARASSMENT|HATE_SPEECH|VIOLENCE|NSFW|OTHER
  description  String   @default("")
  status       String   @default("PENDING") // PENDING|REVIEWING|RESOLVED|DISMISSED
  resolvedBy   String?
  resolution   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  resolvedAt   DateTime?

  @@index([workspaceId, status])
  @@index([targetType, targetId])
  @@index([workspaceId, createdAt])
}

model BannedKeyword {
  id           String   @id @default(cuid())
  workspaceId  String
  keyword      String
  action       String   @default("BLOCK") // BLOCK|REVIEW|REPLACE
  replacement  String?
  severity     String   @default("MEDIUM")
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([workspaceId, keyword])
  @@index([workspaceId])
}

model AuditLog {
  id           String   @id @default(cuid())
  workspaceId  String
  actorId      String
  actorRole    String?
  action       String
  targetType   String?
  targetId     String?
  metadata     String   @default("{}")
  ip           String?
  createdAt    DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorId])
  @@index([action, createdAt])
}

model MemberWarning {
  id           String   @id @default(cuid())
  memberId     String
  workspaceId  String
  issuedBy     String
  reason       String
  severity     String   @default("WARNING")
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([workspaceId])
  @@index([memberId])
  @@index([issuedBy])
}

model Customer {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  email        String
  tags         String   @default("")
  ltv          Float    @default(0)
  ordersCount  Int      @default(0)
  status       String   @default("ACTIVE") // ACTIVE|CHURNED|LEAD
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model EmailCampaign {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  subject      String
  previewText  String    @default("")
  body         String    @default("")
  type         String    @default("BROADCAST") // BROADCAST|AUTOMATION|SEQUENCE
  status       String    @default("DRAFT") // DRAFT|SCHEDULED|SENT
  audience     String    @default("ALL") // ALL|STUDENTS|CUSTOMERS|MEMBERS
  recipients   Int       @default(0)
  openRate     Float     @default(0)
  clickRate    Float     @default(0)
  sentAt       DateTime?
  scheduledAt  DateTime?
  createdBy     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model Affiliate {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  email        String
  code         String
  clicks       Int      @default(0)
  conversions  Int      @default(0)
  earnings     Float    @default(0)
  commissionRate Float  @default(0.3) // 0.3 = 30% (decimal, not percentage)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model WebPage {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String
  slug         String
  type         String   @default("LANDING") // LANDING|SALES|HOME|ABOUT|CONTACT|BLOG|PRICING
  status       String   @default("PUBLISHED")
  visits       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model MembershipPlan {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  price        Float
  interval     String   @default("MONTHLY") // MONTHLY|YEARLY|LIFETIME
  members      Int      @default(0)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model AiConversation {
  id           String   @id @default(cuid())
  userId       String
  tool         String   @default("CHAT") // CHAT|COURSE|LESSON|EMAIL|SALES|BLOG|SOCIAL|SCRIPT
  title        String
  messages     String   @default("[]") // JSON array
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  amount       Int      // negative = spent, positive = purchased
  reason       String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ===== AI Platform (database-driven, admin-managed) =====

model AiProvider {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  // Capabilities — what this provider can do (TEXT | IMAGE | VIDEO | AUDIO | EMBEDDING | STT | TTS | VISION | OCR | RERANKER | MODERATION)
  capabilities    String   @default("TEXT") // comma-separated
  apiKey          String   @default("")
  baseUrl         String   @default("")
  webhookSecret   String   @default("")
  // Auth — for custom OpenAI-compatible endpoints
  authType        String   @default("bearer") // bearer | x-api-key | custom-header | query-param
  headers         String   @default("{}") // JSON: custom headers
  // State
  isActive        Boolean  @default(true)
  isHealthy       Boolean  @default(true)
  priority        Int      @default(10)
  // Budgets (USD)
  dailyBudget     Float    @default(100)
  monthlyBudget   Float    @default(2000)
  // Limits
  dailyRequests   Int      @default(10000)
  monthlyRequests Int      @default(300000)
  timeout         Int      @default(60)
  retries         Int      @default(2)
  concurrency     Int      @default(5)
  fallbackProviderId String?
  // Metadata
  description     String   @default("")
  docsUrl         String   @default("")
  logoUrl         String   @default("")
  providerVersion String   @default("")
  // Health & quota
  lastHealthCheck DateTime?
  lastSyncAt      DateTime?
  quotaRemaining  String   @default("") // provider-specific quota info
  latencyMs       Int      @default(0) // last measured latency
  // Routing strategy — what creators choose (Fast | Balanced | Best | Creative | Reasoning)
  defaultStrategy String   @default("balanced") // fast | balanced | best | creative | reasoning
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Relations
  models          AiModel[]
  keys            AiProviderKey[]
  routes          AiRoute[] @relation("RouteProvider")
  fallbackRoutes  AiRoute[] @relation("RouteFallback")
  jobs            AiJob[]
  logs            AiLog[]
  costs           AiCost[]
  webhooks        AiWebhook[]
  healthChecks    AiProviderHealth[]
  syncHistory     AiProviderSyncHistory[]
}

model AiModel {
  id           String   @id @default(cuid())
  providerId   String
  name         String   // internal id (e.g. deepseek/deepseek-chat)
  displayName  String   // what shows in admin (creators never see this)
  modality     String   @default("TEXT") // TEXT | IMAGE | VIDEO | AUDIO | EMBEDDING | STT | TTS | VISION
  contextWindow Int     @default(128000)
  isDefault    Boolean  @default(false)
  costMultiplier Float  @default(1.0)
  inputCostPer1k  Float @default(0)   // USD per 1k input tokens (admin only)
  outputCostPer1k Float @default(0)   // USD per 1k output tokens (admin only)
  // Capability flags — auto-discovered from provider API where possible
  supportsVision      Boolean @default(false)
  supportsImage       Boolean @default(false) // can generate images
  supportsAudio       Boolean @default(false)
  supportsVideo       Boolean @default(false)
  supportsEmbeddings  Boolean @default(false)
  supportsStreaming   Boolean @default(true)
  supportsJson        Boolean @default(false) // JSON mode
  supportsToolCalling Boolean @default(false) // tool use / function calling
  supportsReasoning   Boolean @default(false) // thinking / chain-of-thought
  // ── Provider status & verification ────────────────────────────────────────
  // providerStatus: the model's status as reported by the provider.
  //   available   = model exists and is usable by this API key
  //   unavailable = model exists in catalog but can't be used (quota/account restriction)
  //   deprecated  = provider has marked this model as deprecated
  //   disabled    = provider has disabled this model
  //   preview     = model is in preview/beta
  //   beta        = model is in beta
  //   private     = model requires special access
  //   unknown     = status couldn't be determined (treat as unavailable)
  providerStatus  String  @default("available")
  // isVerified: true only after a real test request confirmed the model works
  // with this API key. Unverified models exist in the catalog but haven't been tested.
  isVerified      Boolean @default(false)
  // lastTestedAt: when this model was last tested with a real request
  lastTestedAt    DateTime?
  // latencyMs: last measured latency from a test request
  latencyMs       Int     @default(0)
  // ── Sync metadata ─────────────────────────────────────────────────────────
  providerTags  String   @default("[]") // JSON array of tags from provider
  isCustomPricing Boolean @default(false) // admin overrode pricing
  lastSyncedAt  DateTime?
  isActive      Boolean  @default(true)  // admin-enabled (false = excluded from routing)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  provider     AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([modality, isActive])
  @@index([providerStatus])
  @@unique([providerId, name])
}

model AiProviderKey {
  id          String   @id @default(cuid())
  providerId  String
  label       String   @default("Primary") // human label
  keyValue    String   // the actual secret (masked in API responses)
  maskedValue String   @default("") // e.g. sk-...XXXX
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  lastRotatedAt DateTime?
  rotatedFrom String?  @default("") // previous masked value, audit trail
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider    AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

// Routing — maps an AI tool category to a provider + model.
// Creators never see this — Super Admin configures it.
model AiRoute {
  id                String   @id @default(cuid())
  toolCategory      String   @unique // WRITING | MARKETING | COURSE | WEBSITE | SEO | EMAIL | BLOG | CRM | AUTOMATION | IMAGE | VIDEO | VOICE | STT | EMBEDDING
  providerId        String
  fallbackProviderId String?
  modelId           String?  // specific model override (null = provider default)
  strategy          String   @default("smart") // smart | cost | quality | round_robin
  weight            Int      @default(100)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  provider          AiProvider @relation("RouteProvider", fields: [providerId], references: [id], onDelete: Cascade)
  fallbackProvider  AiProvider? @relation("RouteFallback", fields: [fallbackProviderId], references: [id], onDelete: SetNull)
}

model AiTool {
  id           String   @id @default(cuid())
  slug         String   @unique // COURSE_GENERATOR | EMAIL_WRITER | ...
  name         String
  description  String
  icon         String   @default("Sparkles")
  category     String   @default("Content") // Content | Courses | Marketing | Sales | Strategy | Image | Video | Voice
  // Routing — every tool maps to a route category so Super Admin can change providers without code changes
  routeCategory String  @default("WRITING") // WRITING | MARKETING | COURSE | WEBSITE | SEO | EMAIL | BLOG | CRM | AUTOMATION | IMAGE | VIDEO | VOICE | STT | EMBEDDING
  systemPrompt String   @default("")
  userInputPrompt String @default("") // template injected with user input
  creditCost   Int      @default(5)
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(4000)
  outputType   String   @default("MARKDOWN") // MARKDOWN | COURSE | LESSON | EMAIL | SALES_PAGE | BLOG | SOCIAL | SCRIPT | PRODUCT | LANDING | IMAGE | VIDEO
  isVisible    Boolean  @default(true)
  isPro        Boolean  @default(false)
  outputSchema String   @default("") // JSON schema hint for structured outputs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  generations  AiGeneration[]
}

model AiGeneration {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String   @default("default")
  toolId       String
  toolSlug     String
  routeCategory String  @default("WRITING")
  providerSlug String   @default("") // which provider actually served this (admin-only)
  modelId      String   @default("") // which model served this (admin-only)
  jobId        String?  // link to async AiJob if generated through queue
  assetId      String?  // link to saved AiAsset (null if not yet saved)
  title        String
  input        String   @default("") // user prompt
  output       String   @default("") // raw AI text or asset URL
  structured   String   @default("{}") // JSON structured output (course obj, etc.)
  status       String   @default("COMPLETED") // PENDING | COMPLETED | FAILED | CANCELLED
  errorMessage String   @default("")
  creditsUsed  Int      @default(0)
  costUsd      Float    @default(0) // actual provider cost in USD
  durationMs   Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  metadata     String   @default("{}") // prompt params, style, ratio, etc.
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool         AiTool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([toolId])
  @@index([workspaceId, createdAt])
  @@index([routeCategory])
  @@index([status])
}

// ===== AI Jobs — async queue for image/video/avatar generation (Fal AI style) =====
model AiJob {
  id           String   @id @default(cuid())
  workspaceId  String   @default("default")
  userId       String
  providerId   String
  providerSlug String   @default("")
  // Job payload
  type         String   // IMAGE_GEN | VIDEO_GEN | IMAGE_UPSCALE | BG_REMOVE | IMAGE_VARIATION | FACE_SWAP | AVATAR_GEN | VIDEO_UPSCALE
  prompt       String   @default("")
  params       String   @default("{}") // style, ratio, duration, resolution, seed, etc.
  // External
  externalId   String?  // provider's job id (Fal AI request_id)
  externalUrl  String   @default("") // webhook URL or result URL
  // State
  status       String   @default("QUEUED") // QUEUED | RENDERING | PROCESSING | COMPLETED | FAILED | CANCELLED
  progress     Int      @default(0) // 0-100
  errorMessage String   @default("")
  // Output
  resultUrl    String   @default("")
  resultMeta   String   @default("{}") // width, height, duration, etc.
  // Cost
  creditsUsed  Int      @default(0)
  costUsd      Float    @default(0)
  // Audit
  createdAt    DateTime @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  updatedAt    DateTime @updatedAt

  provider     AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([externalId])
}

// ===== AI Assets — every generated output becomes a reusable asset =====
model AiAsset {
  id           String   @id @default(cuid())
  workspaceId  String   @default("default")
  userId       String
  generationId String?  // link back to AiGeneration (nullable for uploaded assets)
  // Categorization
  type         String   // IMAGE | VIDEO | AUDIO | DOCUMENT | TEMPLATE | LOGO | ICON
  folder       String   @default("AI Images") // AI Images | AI Videos | AI Logos | AI Icons | AI Audio | AI Documents | AI Templates
  name         String
  description  String   @default("")
  // Storage
  url          String   // public URL
  thumbnailUrl String   @default("")
  fileSize     Int      @default(0) // bytes
  mimeType     String   @default("")
  width        Int      @default(0)
  height       Int      @default(0)
  duration     Int      @default(0) // seconds, for video/audio
  // Metadata
  prompt       String   @default("") // original prompt
  style        String   @default("")
  aspectRatio  String   @default("")
  tags         String   @default("[]") // JSON array
  // Creator state
  isFavorite   Boolean  @default(false)
  isUsed       Boolean  @default(false) // has been used in any module
  usedIn       String   @default("[]") // JSON array of {module, entityId}
  // Audit
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, type])
  @@index([workspaceId, folder])
  @@index([userId, createdAt])
  @@index([isFavorite])
}

// ===== AI Brand Profiles — creator brand voice (no provider/model info) =====
model AiBrandProfile {
  id           String   @id @default(cuid())
  workspaceId  String   @unique
  brandVoice   String   @default("professional") // professional | casual | witty | authoritative | friendly | inspirational
  tone         String   @default("confident") // confident | warm | playful | serious | energetic | calm
  language     String   @default("en") // ISO code
  primaryColor String   @default("#10b981")
  secondaryColor String @default("#0ea5e9")
  logoUrl      String   @default("")
  defaultAspectRatio String @default("1:1")
  // Brand guidelines (free text)
  guidelines   String   @default("")
  // Audience
  targetAudience String @default("")
  // Audit
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ===== AI Projects — group assets/generations by project =====
model AiProject {
  id           String   @id @default(cuid())
  workspaceId  String   @default("default")
  userId       String
  name         String
  description  String   @default("")
  color        String   @default("#10b981")
  status       String   @default("ACTIVE") // ACTIVE | ARCHIVED | COMPLETED
  assetCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([userId, createdAt])
}

// ===== AI Usage — aggregate per workspace/user/tool/day for analytics & cost control =====
model AiUsage {
  id           String   @id @default(cuid())
  workspaceId  String   @default("default")
  userId       String
  toolSlug     String
  routeCategory String
  providerSlug String
  // Day bucket
  day          DateTime
  // Counts
  requests     Int      @default(0)
  creditsUsed  Int      @default(0)
  costUsd      Float    @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  durationMs   Int      @default(0)
  failures     Int      @default(0)
  // Audit
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([workspaceId, userId, toolSlug, day])
  @@index([workspaceId, day])
  @@index([userId, day])
}

// ===== AI Logs — every request (admin-only audit trail) =====
model AiLog {
  id           String   @id @default(cuid())
  workspaceId  String   @default("default")
  userId       String
  providerId   String
  providerSlug String
  modelId      String   @default("")
  toolSlug     String   @default("")
  routeCategory String  @default("")
  // Request
  requestType  String   // CHAT | GENERATE | IMAGE | VIDEO | EMBEDDING | STT | TTS
  inputPreview String   @default("") // first 500 chars (sanitized)
  // Response
  status       String   @default("OK") // OK | ERROR | TIMEOUT | RATE_LIMITED | QUOTA_EXCEEDED
  errorCode    String   @default("")
  errorMessage String   @default("")
  // Performance
  durationMs   Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  // Cost
  creditsUsed  Int      @default(0)
  costUsd      Float    @default(0)
  // Audit
  ip           String   @default("")
  userAgent    String   @default("")
  createdAt    DateTime @default(now())

  provider     AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([providerId, createdAt])
  @@index([status, createdAt])
}

// ===== AI Costs — daily cost aggregation per provider =====
model AiCost {
  id           String   @id @default(cuid())
  providerId   String
  day          DateTime
  // Cost breakdown
  totalCostUsd Float    @default(0)
  totalCredits Int      @default(0)
  requests     Int      @default(0)
  failures     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  // Budget tracking
  budgetExceeded Boolean @default(false)
  autoDisabled  Boolean @default(false)
  // Audit
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider     AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, day])
  @@index([day])
}

// ===== AI Storage — track storage usage per workspace =====
model AiStorage {
  id           String   @id @default(cuid())
  workspaceId  String   @unique
  // Bytes (BigInt — SQLite INT is 32-bit, max ~2GB; we need to track >5GB)
  imagesBytes  BigInt   @default(0)
  videosBytes  BigInt   @default(0)
  audioBytes   BigInt   @default(0)
  documentsBytes BigInt @default(0)
  totalBytes   BigInt   @default(0)
  // Limits (bytes) — 5 GB default
  quotaBytes   BigInt   @default(5368709120)
  // Counts
  assetCount   Int      @default(0)
  // Audit
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ===== AI Webhooks — incoming webhook log for async providers =====
model AiWebhook {
  id           String   @id @default(cuid())
  providerId   String
  externalId   String   @default("") // provider's job id
  event        String   @default("") // e.g. generation.completed, generation.failed
  payload      String   @default("{}") // raw JSON
  processed    Boolean  @default(false)
  processedAt  DateTime?
  errorMessage String   @default("")
  receivedAt   DateTime @default(now())

  provider     AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, receivedAt])
  @@index([externalId])
  @@index([processed])
}

// ===== AI Rate Limits — per-user/workspace request rate tracking =====
model AiRateLimit {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  routeCategory String
  // Sliding window: minute + hour buckets
  minuteWindow DateTime
  hourWindow   DateTime
  requests     Int      @default(0)
  // Config (cached here for fast lookup)
  maxPerMinute Int      @default(60)
  maxPerHour   Int      @default(600)
  // Audit
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([workspaceId, userId, routeCategory, minuteWindow])
  @@index([workspaceId, hourWindow])
}

// ===== AI Provider Health — history of health checks =====
model AiProviderHealth {
  id           String   @id @default(cuid())
  providerId   String
  // Check result
  status       String   // healthy | degraded | down
  latencyMs    Int      @default(0)
  errorCode    String   @default("")
  errorMessage String   @default("")
  // Details
  checkedAt    DateTime @default(now())
  // Tests run
  testsRun     String   @default("[]") // JSON: ["health","prompt","streaming","tool"]
  testsPassed  String   @default("[]") // JSON: ["health","prompt"]
  // Metadata captured
  providerVersion String @default("")
  quotaRemaining  String @default("")
  modelCount      Int    @default(0)

  provider     AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, checkedAt])
}

// ===== AI Provider Sync History — model discovery logs =====
model AiProviderSyncHistory {
  id           String   @id @default(cuid())
  providerId   String
  // Sync result
  status       String   // success | partial | failed
  modelsFound  Int      @default(0)
  modelsAdded  Int      @default(0)
  modelsUpdated Int     @default(0)
  modelsRemoved Int     @default(0)
  modelsKept   Int      @default(0)
  // Details
  errorMessage String   @default("")
  syncedAt     DateTime @default(now())
  durationMs   Int      @default(0)

  provider     AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, syncedAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @default("")
  category    String   @default("general") // general | billing | ai | storage | email
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Pages & Funnels system =====

model Page {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String
  slug         String
  type         String   @default("PAGE") // PAGE | LANDING | FUNNEL_STEP | BLOG | HOME | ABOUT | CONTACT | LEGAL | THANK_YOU
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | SCHEDULED
  category     String   @default("General") // for landing pages: Course | Membership | Product | Community | Agency | SaaS | LeadMagnet | Newsletter | Webinar | Coaching
  funnelId     String?
  seoTitle     String   @default("")
  seoDescription String @default("")
  ogImage      String   @default("")
  schema       String   @default("{}")
  visits       Int      @default(0)
  conversions  Int      @default(0)
  publishedAt  DateTime?
  scheduledAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sections     PageSection[]
  versions     PageVersion[]
  funnelSteps  FunnelStep[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model PageSection {
  id          String   @id @default(cuid())
  pageId      String
  type        String   // HERO | FEATURES | BENEFITS | PRICING | TESTIMONIALS | FAQ | VIDEO | GALLERY | COUNTDOWN | CTA | NEWSLETTER | FOOTER | TEXT | HEADING
  content     String   @default("{}") // JSON content
  position    Int      @default(0)
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, position])
}

model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  version     Int
  sections    String   @default("[]") // JSON snapshot of sections
  note        String   @default("")
  createdAt   DateTime @default(now())

  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@unique([pageId, version])
}

model Funnel {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  description  String   @default("")
  type         String   @default("SALES") // SALES | LEAD | WEBINAR | LAUNCH
  status       String   @default("DRAFT") // DRAFT | LIVE | PAUSED
  visits       Int      @default(0)
  conversions  Int      @default(0)
  revenue      Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps        FunnelStep[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model FunnelStep {
  id          String   @id @default(cuid())
  funnelId    String
  pageId      String?
  name        String
  type        String   // LANDING | CHECKOUT | UPSELL | DOWNSELL | THANK_YOU | EMAIL | COMMUNITY_INVITE | COURSE_ACCESS
  position    Int      @default(0)
  isRequired  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  funnel      Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  page        Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([funnelId, position])
}

model BlogPost {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String
  slug         String
  excerpt      String   @default("")
  content      String   @default("")
  coverUrl     String   @default("")
  category     String   @default("General")
  tags         String   @default("")
  author       String   @default("")
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | SCHEDULED
  seoTitle     String   @default("")
  seoDescription String @default("")
  visits       Int      @default(0)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, publishedAt])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @default("")
  category    String   @default("brand") // brand | header | footer | analytics | seo | domains
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Support Ticket System =====

model SupportTicket {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  subject     String
  description String
  category    String   @default("general") // general | billing | technical | course | product | community
  priority    String   @default("medium") // low | medium | high | urgent
  status      String   @default("open") // open | in_progress | resolved | closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  replies     TicketReply[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([userId])
}

model TicketReply {
  id          String   @id @default(cuid())
  ticketId    String
  userId      String
  content     String
  isStaff     Boolean  @default(false)
  createdAt   DateTime @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

