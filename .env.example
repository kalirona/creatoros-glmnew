# ============================================================================
# CreatorOS Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# In Dokploy, set these as environment variables in the service settings.
# ============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default — stored in /app/db/custom.db inside container)
DATABASE_URL=file:/app/db/custom.db

# For production with PostgreSQL, use:
# DATABASE_URL=postgresql://user:password@host:5432/creatoros?schema=public

# ─── Clerk Authentication ────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → API Keys
# Required for login/signup to work. Without these, the app runs in demo mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── n8n Integration (optional — for AI orchestration) ──────────────────────
# Leave empty to use the built-in AI engine (z.ai SDK)
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_MS=30000
N8N_AI_ENABLED=false

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
